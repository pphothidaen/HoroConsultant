{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index?path=v1/:path*"
    },
    {
      "source": "/bazi/:path*",
      "destination": "/api/index?path=bazi/:path*"
    },
    {
      "source": "/admin",
      "destination": "/api/index?path=admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/index?path=admin/:path*"
    },
    {
      "source": "/hitl/:path*",
      "destination": "/api/index?path=hitl/:path*"
    },
    {
      "source": "/hitl-studio",
      "destination": "/api/index?path=hitl-studio"
    },
    {
      "source": "/docs",
      "destination": "/api/index?path=docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "/api/index?path=docs/:path*"
    },
    {
      "source": "/redoc",
      "destination": "/api/index?path=redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index?path=openapi.json"
    },
    {
      "source": "/metrics",
      "destination": "/api/index?path=metrics"
    },
    {
      "source": "/metrics/:path*",
      "destination": "/api/index?path=metrics/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "https://pphothidaen-horoconsultant-core-backend.static.hf.space/$1"
    }
  ]
}
