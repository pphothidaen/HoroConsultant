{
  "version": 2,
  "builds": [
    {
      "src": "project/static/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/fly/(.*)",
      "dest": "https://horoconsultant-core-backend.fly.dev/api/$1"
    },
    {
      "src": "/api/hf/(.*)",
      "dest": "https://pphothidaen-horoconsultant-core-backend.hf.space/api/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://pphothidaen-horoconsultant-core-backend.hf.space/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/project/static/$1"
    }
  ]
}
