{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/api/hf/(.*)",
      "dest": "https://pphothidaen-horoconsultant-core-backend.hf.space/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/project/static/$1"
    }
  ]
}
