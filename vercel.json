{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index?path=/health"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index?path=/api/v1/:path*"
    },
    {
      "source": "/api/v2/:path*",
      "destination": "/api/index?path=/api/v2/:path*"
    },
    {
      "source": "/api/v3/:path*",
      "destination": "/api/index?path=/api/v3/:path*"
    },
    {
      "source": "/docs",
      "destination": "/api/index?path=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index?path=/openapi.json"
    },
    {
      "source": "/admin/auth/config",
      "destination": "/api/index?path=/admin/auth/config"
    },
    {
      "source": "/admin/auth/google",
      "destination": "/api/index?path=/admin/auth/google"
    },
    {
      "source": "/admin/catalog/summary",
      "destination": "/api/index?path=/admin/catalog/summary"
    },
    {
      "source": "/admin/grayzone",
      "destination": "/api/index?path=/admin/grayzone"
    },
    {
      "source": "/admin/finetune/status",
      "destination": "/api/index?path=/admin/finetune/status"
    },
    {
      "source": "/admin/provider-pools",
      "destination": "/api/index?path=/admin/provider-pools"
    },
    {
      "source": "/hitl/stats",
      "destination": "/api/index?path=/hitl/stats"
    }
  ]
}
