{
  "functions": {
    "api/**/*.py": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/hf/:path*",
      "destination": "https://pphothidaen-horoconsultant-core-backend.hf.space/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/main.js"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/main.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/main.js"
    }
  ]
}
