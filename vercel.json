{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index?path=/health"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index?path=/api/v1/:path*"
    },
    {
      "source": "/api/v2/:path*",
      "destination": "/api/index?path=/api/v2/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/index?path=/admin/:path*"
    },
    {
      "source": "/hitl/:path*",
      "destination": "/api/index?path=/hitl/:path*"
    },
    {
      "source": "/docs",
      "destination": "/api/index?path=docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index?path=openapi.json"
    }
  ]
}
