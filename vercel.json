{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index?path=/health"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index?path=/api/v1/:path*"
    },
    {
      "source": "/api/v2/:path*",
      "destination": "/api/index?path=/api/v2/:path*"
    },
    {
      "source": "/api/v3/:path*",
      "destination": "/api/index?path=/api/v3/:path*"
    },
    {
      "source": "/docs",
      "destination": "/api/index?path=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index?path=/openapi.json"
    }
  ]
}
