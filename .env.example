# ============================================================
# .env.example - Computational Metaphysics Engine
# Local-development template only. Production CI injects GitHub Secrets or
# Doppler-managed environment variables; this file is not a release prerequisite.
# ============================================================

# ------------------------------------------------------------
# Google AI Studio API
# ------------------------------------------------------------
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here

# ------------------------------------------------------------
# API Route Configuration
# ------------------------------------------------------------
PRIMARY_MODEL=gemini-2.5-flash
SECONDARY_MODEL=gemini-1.5-pro
FALLBACK_MODEL=gemini-2.0-flash

# API Behaviour
API_TIMEOUT_SECONDS=8.0
API_MAX_RETRIES=2

# ------------------------------------------------------------
# Ollama Local LLM
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-bazi:7b
OLLAMA_PORT=11434

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Secret key for JWT (if auth is enabled)
SECRET_KEY=change_me_to_a_random_64_char_hex_string

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------
# 6. Hugging Face Docker Backend and Vercel UI
# ------------------------------------------------------------
HF_TOKEN=hf_REPLACE_WITH_YOUR_HUGGINGFACE_TOKEN
HUGGINGFACE_TOKEN=hf_REPLACE_WITH_YOUR_HUGGINGFACE_TOKEN
HF_API_TOKEN=hf_REPLACE_WITH_YOUR_HUGGINGFACE_TOKEN
HUGGINGFACE_API_KEY=hf_REPLACE_WITH_YOUR_HUGGINGFACE_TOKEN
HUGGING_FACE_TOKEN=hf_REPLACE_WITH_YOUR_HUGGING_FACE_TOKEN
HF_USERNAME=pphothidaen
HF_REPO_ID=pphothidaen/qwen2.5-7b-bazi-instruct-4bit
HF_BACKEND_SPACE_ID=pphothidaen/horoconsultant-core-backend
HF_BACKEND_URL=https://pphothidaen-horoconsultant-core-backend.hf.space
# Optional: S3-compatible credentials for HF storage buckets
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_ENDPOINT_URL=https://YOUR_NAMESPACE.s3.amazonaws.com
# Optional: manual Vercel administration. Git integration owns production UI deploys.
VERCEL_TOKEN=REPLACE_WITH_YOUR_VERCEL_TOKEN
VERCEL_STATIC_URL=https://horo-consultant-psi.vercel.app
MLX_OUTPUT_DIR=project/data/mlx_finetune
ADAPTER_PATH=project/models/qwen2.5-bazi-adapter

# ------------------------------------------------------------
# Admin Panel Security Whitelist
# ------------------------------------------------------------
ADMIN_ALLOWED_EMAILS=pansakorn@gmail.com,kimlenglim.work@gmail.com

# ------------------------------------------------------------
# Grafana Cloud Free Tier (grafana.net) Observability
# ------------------------------------------------------------
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
GRAFANA_USER_ID=your_grafana_user_id_here
GRAFANA_API_KEY=glc_REPLACE_WITH_YOUR_GRAFANA_API_KEY
PROMETHEUS_METRICS_ENABLED=true

# ------------------------------------------------------------
# Incident Notifications
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
HEALTH_ALERT_WEBHOOK_URL=

# ------------------------------------------------------------
# 9router Proxy Gateway (Hermes Execution Engine - Hybrid Routing)
# ------------------------------------------------------------
# LOCAL: 9router running on localhost
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=9r-YOUR-VAULT-MANAGED-KEY

# ON-CLOUD / CI/CD: set this in GitHub Actions / Doppler secrets
ROUTER_BASE_URL=https://your-9router-remote-endpoint/v1

# 9router Account Alias (switch between agy1..n, codex1..n)
NINE_ROUTER_ACCOUNT_ALIAS=agy1
ROUTER_ACCOUNT_ALIAS=agy1

# Virtual Model IDs (9router maps these to physical model credentials)

NINE_ROUTER_ORCHESTRATOR_MODEL=claude-3-7-sonnet
NINE_ROUTER_DEVELOPER_MODEL=deepseek-v3
NINE_ROUTER_QA_MODEL=gpt-4o-mini
NINE_ROUTER_DEVOPS_MODEL=gemini-2.0-flash
NINE_ROUTER_REVIEWER_MODEL=deepseek-r1

# Hermes Execution Engine Settings
HERMES_TELEMETRY_ENABLED=true
HERMES_MAX_LOOP_RETRIES=3
