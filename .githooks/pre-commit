#!/bin/sh
# Read-only pre-commit gate. It must never edit or stage repository files.

set -u

if [ -x ".venv/bin/python3" ]; then
    PYTHON=".venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
else
    echo "[ERROR] Pre-commit blocked: Python is required for repository gates."
    exit 1
fi

echo "[INFO] Pre-commit: checking staged test provenance."
if [ -f "scripts/test_provenance_guard.py" ]; then
    "$PYTHON" "scripts/test_provenance_guard.py" staged
    STATUS=$?
    if [ "$STATUS" -ne 0 ]; then
        echo "[ERROR] Pre-commit blocked: test provenance validation failed."
        exit "$STATUS"
    fi
fi

if [ -f "tests/test_notebook_syntax.py" ]; then
    echo "[INFO] Pre-commit: checking notebook syntax."
    "$PYTHON" -m pytest tests/test_notebook_syntax.py -q >/dev/null 2>&1
    STATUS=$?
    if [ "$STATUS" -ne 0 ]; then
        echo "[ERROR] Pre-commit blocked: notebook syntax checks failed."
        echo "[INFO] Run: $PYTHON -m pytest tests/test_notebook_syntax.py -v"
        exit "$STATUS"
    fi
fi

echo "[OK] Pre-commit read-only gates passed."
exit 0
