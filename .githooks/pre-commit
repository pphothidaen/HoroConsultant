#!/bin/sh
# Read-only pre-commit gate. It must never edit or stage repository files.

set -u

if [ -x ".venv/bin/python3" ]; then
    PYTHON=".venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
else
    echo "[ERROR] Pre-commit blocked: Python is required for repository gates."
    exit 1
fi

echo "[INFO] Pre-commit: checking staged test provenance."
if [ -f "scripts/test_provenance_guard.py" ]; then
    "$PYTHON" "scripts/test_provenance_guard.py" staged
    STATUS=$?
    if [ "$STATUS" -ne 0 ]; then
        echo "[ERROR] Pre-commit blocked: test provenance validation failed."
        exit "$STATUS"
    fi
fi

# Jira agent-label governance gate (hook 2b): when the commit references a
# KAN-XX ticket, verify that issue carries an agent-* label. Fail-closed on
# governance violation, fail-open on network/credential unavailability so
# offline work is never blocked.
# NOTE: in pre-commit, COMMIT_EDITMSG may still hold a PREVIOUS message
# (with `git commit -m` the file is written after this hook runs). The
# authoritative check lives in commit-msg; this one is best-effort for
# editor-based commits where COMMIT_EDITMSG is already populated.
COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
if [ -f "scripts/jira_label_gate.py" ] && [ -f "$COMMIT_MSG_FILE" ]; then
    TICKET_KEY=$(head -n 20 "$COMMIT_MSG_FILE" | grep -oE 'KAN-[0-9]+' | head -1 || true)
    if [ -n "$TICKET_KEY" ]; then
        echo "[INFO] Pre-commit: checking Jira agent-label governance for $TICKET_KEY."
        "$PYTHON" "scripts/jira_label_gate.py" check "$TICKET_KEY"
        STATUS=$?
        if [ "$STATUS" -eq 1 ]; then
            echo "[ERROR] Pre-commit blocked: $TICKET_KEY violates agent-label governance (hook 2b)."
            exit 1
        elif [ "$STATUS" -eq 2 ]; then
            echo "[WARN] Jira credentials unavailable - label governance check skipped."
        fi
    fi
fi

if [ -f "tests/test_notebook_syntax.py" ]; then
    echo "[INFO] Pre-commit: checking notebook syntax."
    "$PYTHON" -m pytest tests/test_notebook_syntax.py -q >/dev/null 2>&1
    STATUS=$?
    if [ "$STATUS" -ne 0 ]; then
        echo "[ERROR] Pre-commit blocked: notebook syntax checks failed."
        echo "[INFO] Run: $PYTHON -m pytest tests/test_notebook_syntax.py -v"
        exit "$STATUS"
    fi
fi

echo "[OK] Pre-commit read-only gates passed."
exit 0
