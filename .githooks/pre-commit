#!/bin/sh
# .githooks/pre-commit — Pre-Commit Safety & Syntax Quality Gate
# Validates:
# 1. Zero SyntaxError / Unterminated String Literals in all repository Notebooks (.ipynb)
# 2. Dependency Matrix Compliance (NumPy 2.x & PyArrow 15+ ABI integrity)
# 3. Automatic Version Stamping

echo "🔎 [Pre-Commit] Validating Notebook AST & Python Syntax..."

# Prefer project venv python (has pytest); fall back to system python3
PYTHON=""
if [ -x ".venv/bin/python3" ]; then
    PYTHON=".venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
fi

if [ -z "$PYTHON" ]; then
    echo "[WARN] Python not available; skipping notebook AST check."
    exit 0
fi

# Run the fast dedicated notebook syntax test suite (<0.05s)
if [ -f "tests/test_notebook_syntax.py" ]; then
    "$PYTHON" -m pytest tests/test_notebook_syntax.py -q >/dev/null 2>&1
    STATUS=$?
    if [ $STATUS -ne 0 ]; then
        echo ""
        echo "❌ [Pre-Commit BLOCKED] Notebook Syntax or Dependency Conflict detected!"
        echo "   Run: $PYTHON -m pytest tests/test_notebook_syntax.py -v"
        echo "   Fix: $PYTHON scripts/sync_notebook_cells.py"
        echo ""
        exit 1
    fi
    echo "✅ [Pre-Commit] Notebook AST & Dependency Matrix Passed 100%!"
fi

# Auto-stamp git version into all local source files
STAMP_SCRIPT="scripts/stamp_version.py"
if [ -f "$STAMP_SCRIPT" ]; then
    python3 "$STAMP_SCRIPT" 2>/dev/null
    
    # Stage the stamped files if they were modified
    git add \
        project/static/version.json \
        public/version.json \
        project/static/app.js \
        public/app.js \
        project/static/sw.js \
        public/sw.js \
        project/static/index.html \
        public/index.html \
        2>/dev/null
fi

exit 0
