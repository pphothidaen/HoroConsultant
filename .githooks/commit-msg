#!/usr/bin/env python3
"""Commit-msg hook: validate agent-* label in commit message."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"))

try:
    from jira_label_gate import validate_commit_message
except ImportError:
    # Module not yet created (RED phase) — skip validation
    sys.exit(0)


def main():
    if len(sys.argv) < 2:
        print("ERROR: no commit message file", file=sys.stderr)
        return 1
    
    with open(sys.argv[1], "r") as f:
        message = f.read()
    
    is_valid, issues = validate_commit_message(message)
    if not is_valid:
        print("AGENT LABEL CHECK FAILED:", file=sys.stderr)
        for issue in issues:
            print(f"  - {issue}", file=sys.stderr)
        print("\nAdd an agent-* label, e.g.: feat: foo [KAN-101] agent-hermes", file=sys.stderr)
        return 1
    
    return 0


if __name__ == "__main__":
    sys.exit(main())
