#!/usr/bin/env zsh
#
# HoroConsultant — post-merge hook
# ============================================================================
# Purpose:  Verify documentation index consistency after `git merge` / `git pull`.
# Trigger:  After `git merge` or `git pull` (any branch).
# Mode:     Read-only verification — NEVER edits/stages repo files.
#           Exits 0 = pass, non-zero = warn (console only).
#
# What it checks:
#   1. If `docs/**/*.md` changed in the merge  -> `docs/INDEX.md` consistency
#   2. If `README.md` or `RELEASE_NOTES.md` changed -> re-verify index
#
# ---------------------------------------------------------------------------
# Note: hooksPath = .githooks, so this file must live at
#   .githooks/post-merge
# Install: ln -sf ../../.githooks/post-merge .git/hooks/post-merge
# ============================================================================

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
    echo "[INFO] post-merge: cannot resolve repository root, skipping."
    exit 0
fi

cd "$REPO_ROOT" || exit 0

# ---------------------------------------------------------------------------
# Resolve branch and merge base
# ---------------------------------------------------------------------------
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"
# Find the merge-base with the remote-tracking branch (for pull/merge context)
MERGE_BASE=""
if git rev-parse --verify "refs/remotes/origin/$BRANCH" >/dev/null 2>&1; then
    MERGE_BASE="$(git merge-base HEAD "refs/remotes/origin/$BRANCH" 2>/dev/null || true)"
elif git rev-parse --verify "refs/remotes/upstream/$BRANCH" >/dev/null 2>&1; then
    MERGE_BASE="$(git merge-base HEAD "refs/remotes/upstream/$BRANCH" 2>/dev/null || true)"
fi

# If no remote-tracking branch found (local-only merge), compare with parent commit
if [ -z "$MERGE_BASE" ]; then
    PARENT=$(git rev-parse HEAD^ 2>/dev/null || true)
    if [ -n "$PARENT" ]; then
        MERGE_BASE="$PARENT"
    fi
fi

# ---------------------------------------------------------------------------
# Locate interpreter
# ---------------------------------------------------------------------------
if [ -x "$REPO_ROOT/.venv/bin/python3" ]; then
    PYTHON="$REPO_ROOT/.venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
else
    echo "[INFO] post-merge: python3 not found, skipping verification."
    exit 0
fi

# ---------------------------------------------------------------------------
# Determine changed files in the merge range
# ---------------------------------------------------------------------------
CHANGED_FILES=""
if [ -n "$MERGE_BASE" ]; then
    CHANGED_FILES="$("$PYTHON" -c "
import subprocess, sys
sys.path.insert(0, 'scripts')
from post_commit_check import get_diff_files
files = get_diff_files('$MERGE_BASE', 'HEAD')
print('\n'.join(files))
" 2>/dev/null)" || true
else
    echo "[INFO] post-merge: no merge base available, checking last-commit files instead."
    CHANGED_FILES="$("$PYTHON" -c "
import subprocess, sys
sys.path.insert(0, 'scripts')
from post_commit_check import get_last_commit_files
files = get_last_commit_files()
print('\n'.join(files))
" 2>/dev/null)" || true
fi

if [ -z "$CHANGED_FILES" ]; then
    echo "[INFO] post-merge: no files changed in merge."
    exit 0
fi

echo ""
echo "======================================================================"
echo "  [post-merge] HoroConsultant SDLC — documentation sync check"
echo "  Branch : $BRANCH"
echo "  Changed files: $(echo "$CHANGED_FILES" | wc -l) file(s)"
echo "======================================================================"
echo "$CHANGED_FILES" | while read -r f; do
    echo "    - $f"
done

# ---------------------------------------------------------------------------
# Route to appropriate check
# ---------------------------------------------------------------------------
DOC_CHANGED=0
while IFS= read -r f; do
    if [[ "$f" == *.md ]] || [[ "$f" == *.txt ]] || [[ "$f" == *.puml ]]; then
        DOC_CHANGED=1
    fi
done <<< "$CHANGED_FILES"

if [ "$DOC_CHANGED" -eq 1 ]; then
    echo ""
    echo "[INFO] Documentation files changed in merge — verifying INDEX consistency..."
    "$PYTHON" -c "
import subprocess, sys
sys.path.insert(0, 'scripts')
from post_commit_check import check_index_consistency
ok, msg = check_index_consistency()
print(f'[INFO] >>> {msg}')
if not ok:
    print('[WARN] Run: python3 scripts/verify_doc_index.py')
    sys.exit(1)
" 2>&1 || true
else
    echo ""
    echo "[INFO] No documentation files changed in merge — skip INDEX verification."
fi

echo ""
echo "[OK] post-merge verification complete (non-blocking, console only)."
exit 0