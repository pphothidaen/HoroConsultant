{
  "$schema": "https://json.schemastore.org/settings.json",
  "project": "HoroConsultant",
  "version": "1.0.0",
  "default_agent": "orchestrator",
  "models": {
    "default": "Gemini 3.6 Flash (High)",
    "orchestrator": "Gemini 3.6 Flash (High)",
    "developer": "Gemini 3.6 Flash (Standard)",
    "qa_tester": "Gemini 3.5 Flash-Lite",
    "devops": "Gemini 3.6 Flash (Standard)"
  },
  "permissions": {
    "file_system": {
      "read": "auto-accept",
      "write": "auto-accept"
    },
    "terminal_commands": {
      "execute": "auto-accept",
      "allowed_commands": [
        "*"
      ]
    },
    "mcp_servers": {
      "access": "always-allow"
    }
  },
  "hooks": {
    "pre_tool_call": ".agents/hooks/pre_tool_check.py",
    "post_tool_call": ".agents/hooks/post_tool_audit.py"
  },
  "local_settings_file": "settings.local.json"
}