{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horoconsultant.local/schemas/multiagent-dispatch-receipt-v1.schema.json",
  "title": "HoroConsultant ExecutionReceipt Result Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "policy_version",
    "decision_sha256",
    "dispatch_identity",
    "dispatch_ticket_id",
    "attempt_id",
    "alias",
    "provider",
    "adapter",
    "model",
    "effort",
    "objective",
    "ownership",
    "quota_status",
    "started_at",
    "ended_at",
    "exit_code",
    "transport_status",
    "output_bytes",
    "output_sha256",
    "work_result_sha256"
  ],
  "properties": {
    "protocol_version": {"const": 2},
    "policy_version": {"type": "string", "minLength": 1},
    "decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dispatch_identity": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dispatch_ticket_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "attempt_id": {"type": "integer", "minimum": 1},
    "alias": {"enum": ["codex1", "codex2", "agy1", "agy2"]},
    "provider": {"enum": ["codex", "agy"]},
    "adapter": {"enum": ["codex-jsonl-output-schema-v2", "agy-stream-json-schema-v2"]},
    "model": {"type": "string", "minLength": 1},
    "effort": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "ownership": {"type": "string", "minLength": 1},
    "quota_status": {"enum": ["healthy", "constrained", "below_10_percent", "unknown"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": "integer"},
    "transport_status": {"const": "completed"},
    "process_or_session_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "output_bytes": {"type": "integer", "minimum": 1},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "work_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
