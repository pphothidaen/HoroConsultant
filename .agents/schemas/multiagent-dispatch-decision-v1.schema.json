{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horoconsultant.local/schemas/multiagent-dispatch-decision-v1.schema.json",
  "title": "HoroConsultant DispatchDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticket",
    "phase",
    "scope_rank",
    "complexity_rank",
    "risk_rank",
    "ambiguity_rank",
    "evidence_burden_rank",
    "quota_band",
    "work_mode",
    "selected_alias",
    "selected_model",
    "selected_effort",
    "rationale",
    "policy_version",
    "planning_to_medium_confirmed",
    "hitl_approved"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "ticket": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "phase": {"enum": ["planning", "implementation", "qa", "review", "release", "operations"]},
    "scope_rank": {"type": "integer", "minimum": 0, "maximum": 3},
    "complexity_rank": {"type": "integer", "minimum": 0, "maximum": 3},
    "risk_rank": {"type": "integer", "minimum": 0, "maximum": 3},
    "ambiguity_rank": {"type": "integer", "minimum": 0, "maximum": 3},
    "evidence_burden_rank": {"type": "integer", "minimum": 0, "maximum": 3},
    "quota_band": {"enum": ["healthy", "constrained", "below_10_percent", "unknown"]},
    "work_mode": {"enum": ["read_only", "mutation"]},
    "selected_alias": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "selected_model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "selected_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]},
    "rationale": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "planning_to_medium_confirmed": {"type": "boolean"},
    "hitl_approved": {"type": "boolean"},
    "quality_exception": {"type": "string", "minLength": 1}
  }
}
