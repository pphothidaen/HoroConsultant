{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horoconsultant.local/schemas/test-provenance-v1.schema.json",
  "title": "Test Provenance Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticket_id",
    "sequence",
    "provenance_status",
    "baseline_parent",
    "test_files",
    "red_tests",
    "allowed_source_paths",
    "test_owner_role",
    "reviewer_role",
    "supersedes",
    "correction_reason",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "test-provenance-v1"
    },
    "ticket_id": {
      "type": "string",
      "pattern": "^TICKET-[A-Z0-9][A-Z0-9-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "provenance_status": {
      "enum": [
        "VERIFIED",
        "RECONSTRUCTED"
      ]
    },
    "baseline_parent": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "test_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(tests|project/tests|TDD-HORO-v3\\.0/tests)/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "red_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "expected_exit",
          "failure_fingerprint"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_exit": {
            "type": "integer",
            "not": {
              "const": 0
            }
          },
          "failure_fingerprint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "allowed_source_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_owner_role": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      ]
    },
    "correction_reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
