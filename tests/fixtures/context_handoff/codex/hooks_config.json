{
  "description": "Local non-managed context handoff request hooks; native user review of the exact current hook hash remains external, and SessionEnd is synchronous, non-steering, and capped at three seconds.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/context_handoff.py\" hook --runtime codex --event SessionStart --native",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/context_handoff.py\" hook --runtime codex --event PreCompact --native",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/context_handoff.py\" hook --runtime codex --event PostCompact --native",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/context_handoff.py\" hook --runtime codex --event Stop --native",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/context_handoff.py\" hook --runtime codex --event SessionEnd --native",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
