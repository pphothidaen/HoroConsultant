{
  "name": "horo-consultant",
  "main": "api/index.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "limits": {
    "cpu_ms": 50,
    "execution_timeout": 30
  },
  "placement": {
    "mode": "smart"
  }
}
