# ============================================================
# Dockerfile.hf — Hugging Face Spaces Optimized Dockerfile
# Base: Ubuntu 22.04 LTS
# Target: Hugging Face Spaces (Port 7860, User 1000)
# ============================================================

FROM ubuntu:22.04 AS base

LABEL maintainer="Computational Metaphysics Engine"
LABEL version="1.0.0"
LABEL description="HoroConsultant Core Backend Dockerfile for HuggingFace Spaces"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PORT=7860

RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11 1

WORKDIR /code

COPY requirements.txt /code/requirements.txt
RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir -r requirements.txt

# Create non-root user with UID 1000 for HuggingFace Spaces compatibility
RUN useradd -m -u 1000 user
USER user
ENV PATH="/home/user/.local/bin:$PATH"

WORKDIR /code

# Copy project files
COPY --chown=user:user project/  /code/project/
COPY --chown=user:user tests/    /code/tests/
COPY --chown=user:user scripts/  /code/scripts/
COPY --chown=user:user .env.example /code/.env.example

EXPOSE 7860

# Run FastAPI server on port 7860
CMD ["python3", "-m", "uvicorn", "project.main:app", "--host", "0.0.0.0", "--port", "7860"]
