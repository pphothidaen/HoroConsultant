{
  "description": "HoroConsultant AGY Hooks Configuration with atomic TDD governance",
  "version": "1.2.0",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agy/hooks/atomic-tdd-guard.sh"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "sequential": true,
        "hooks": [
          {"name": "context-handoff-stop-normalizer", "type": "command", "command": "bash \"$(git rev-parse --show-toplevel)/.agy/hooks/stop-monitor.sh\"", "timeout": 3000}
        ]
      }
    ]
  }
}
